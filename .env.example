# ------------------------------------------------------------------
# PDFDesk configuration. Copy this file to ".env" and change the values.
#   cp .env.example .env
# Never commit your real .env file.
# ------------------------------------------------------------------

# --- Website -------------------------------------------------------
# Your domain name (e.g. pdf.example.com). Use "localhost" to try it on your own computer (HTTP only).
DOMAIN=localhost
# The full public address of the site, used in emails (reset links, signing links, review links).
PUBLIC_URL=http://localhost
# Allowed browser origins for the API (comma separated). Usually the same as PUBLIC_URL.
CORS_ORIGINS=http://localhost
# "production" in real deployments, "development" locally (prints emails to the log when SMTP is empty).
ENVIRONMENT=production

# --- Security ------------------------------------------------------
# A long random secret used to sign login tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts (minutes). 10080 = 7 days.
JWT_EXPIRE_MINUTES=10080

# --- Database (PostgreSQL) -----------------------------------------
POSTGRES_PASSWORD=change-me-db-password
# DATABASE_URL is built automatically by docker-compose from POSTGRES_PASSWORD.
# For running the API without Docker, set it yourself, e.g.:
# DATABASE_URL=postgresql+psycopg://pdfdesk:change-me-db-password@localhost:5432/pdfdesk

# --- File storage (MinIO / S3-compatible) --------------------------
MINIO_ROOT_USER=pdfdesk
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_BUCKET=pdfdesk
S3_REGION=us-east-1
# To use AWS S3 or Lightsail Object Storage instead of MinIO, override these in docker-compose.yml:
# S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...

# --- Email (SMTP) - password reset, signature requests --------------
# Example for Gmail: smtp.gmail.com, port 587, an "App password" as SMTP_PASSWORD.
# Example for AWS SES: email-smtp.ap-south-1.amazonaws.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PDFDesk <no-reply@example.com>
SMTP_STARTTLS=true

# --- Let's Encrypt -------------------------------------------------
# Email for certificate expiry notices.
LETSENCRYPT_EMAIL=you@example.com

# --- AI assistant (optional) ---------------------------------------
# Anthropic API key from https://console.anthropic.com/ . Leave empty to hide the AI assistant.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Limits --------------------------------------------------------
MAX_UPLOAD_MB=100
GUEST_FILE_TTL_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
# Seconds before long-running tools are stopped.
LIBREOFFICE_TIMEOUT=180
GHOSTSCRIPT_TIMEOUT=300
OCR_TIMEOUT=900
CHROMIUM_TIMEOUT=60
VERAPDF_TIMEOUT=180
JOB_TIMEOUT_SECONDS=1200
# Number of background worker containers (each handles one job at a time).
WORKER_REPLICAS=2
# Days between automatic reminder emails to signers who have not signed.
SIGNATURE_REMINDER_DAYS=3
